---
import Layout from '../layouts/Layout.astro'
import ProjectCard from '../components/ProjectCard.astro'
import Modal from '../components/Modal.svelte'
import { projects } from '../data/projects'
---

<Layout>
  <main class="max-w-5xl mx-auto px-6">

    <!-- Nav -->
    <nav class="flex items-center justify-between py-8">
      <span class="text-sm font-mono font-bold" style="color: #f97316;">Deep Sarkar</span>
<div class="flex items-center gap-7 text-sm" style="color: rgba(250,247,242,0.4);">
        <a href="https://github.com/dsarkar10" target="_blank" rel="noopener"
           style="transition: color 0.15s;"
           onmouseover="this.style.color='#faf7f2'"
           onmouseout="this.style.color='rgba(250,247,242,0.4)'">GitHub</a>
        <a href="https://codeforces.com/profile/dsarkar" target="_blank" rel="noopener"
           style="transition: color 0.15s;"
           onmouseover="this.style.color='#faf7f2'"
           onmouseout="this.style.color='rgba(250,247,242,0.4)'">Codeforces</a>
<a href="https://linkedin.com/in/dsarkar10" target="_blank" rel="noopener"
           style="transition: color 0.15s;"
           onmouseover="this.style.color='#faf7f2'"
           onmouseout="this.style.color='rgba(250,247,242,0.4)'">LinkedIn</a>
        <button onclick="navigator.clipboard.writeText('dsarkarhq@gmail.com'); const btn = this; btn.innerText = 'Copied!'; setTimeout(() => btn.innerText = 'Email (dsarkarhq@gmail.com)', 1500)"
            style="transition: color 0.15s; background: none; border: none; color: rgba(250,247,242,0.4); cursor: pointer; font-size: inherit; font-family: inherit;"
            onmouseover="this.style.color='#faf7f2'"
            onmouseout="this.style.color='rgba(250,247,242,0.4)'">Email (dsarkarhq@gmail.com)</button>
      </div>
    </nav>

    <!-- Hero -->
    <header class="pt-16 pb-20 max-w-xl">
      <p class="font-mono text-xs uppercase tracking-widest mb-5"
         style="color: #ea580c;">
        NIT Rourkela &nbsp;·&nbsp; Biomedical Engineering &nbsp;·&nbsp; 2026
      </p>
      <h1 class="text-5xl font-black tracking-tight leading-tight mb-6"
          style="color: #faf7f2;">
        Backend &<br/>
        <span style="color: #f97316;">Systems Engineer.</span>
      </h1>
      <p class="text-base leading-relaxed" style="color: rgba(250,247,242,0.45);">
        I build low-latency infrastructure — matching engines, distributed pipelines,
        real-time systems. NIT Rourkela · 2026.
      </p>

<div class="flex flex-wrap items-center gap-3 mt-8">
        <a href="https://github.com/dsarkar10" target="_blank" rel="noopener"
           class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap"
           style="background: #ea580c; color: #faf7f2; transition: background 0.15s;"
           onmouseover="this.style.background='#f97316'"
           onmouseout="this.style.background='#ea580c'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/></svg>
          GitHub
        </a>
        <button onclick="navigator.clipboard.writeText('dsarkarhq@gmail.com'); const btn = this; btn.innerText = 'Copied!'; setTimeout(() => btn.innerText = 'Contact', 1500)"
            class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm whitespace-nowrap"
            style="border: 1px solid rgba(250,247,242,0.12); color: rgba(250,247,242,0.4); transition: all 0.15s; background: none; cursor: pointer; font-family: inherit;"
            onmouseover="this.style.borderColor='rgba(250,247,242,0.3)'; this.style.color='#faf7f2'"
            onmouseout="this.style.borderColor='rgba(250,247,242,0.12)'; this.style.color='rgba(250,247,242,0.4)'">
           Contact
         </button>
        <a href="/resume-sde.pdf" download="Deep_Sarkar_Resume_SDE.pdf"
           class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm whitespace-nowrap"
           style="border: 1px solid rgba(250,247,242,0.12); color: rgba(250,247,242,0.4); transition: all 0.15s;"
           onmouseover="this.style.borderColor='rgba(249,115,22,0.5)'; this.style.color='#f97316'"
           onmouseout="this.style.borderColor='rgba(250,247,242,0.12)'; this.style.color='rgba(250,247,242,0.4)'">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Resume — SDE
        </a>
        <a href="/resume-quant.pdf" download="Deep_Sarkar_Resume_Quant.pdf"
           class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm whitespace-nowrap"
           style="border: 1px solid rgba(250,247,242,0.12); color: rgba(250,247,242,0.4); transition: all 0.15s;"
           onmouseover="this.style.borderColor='rgba(249,115,22,0.5)'; this.style.color='#f97316'"
           onmouseout="this.style.borderColor='rgba(250,247,242,0.12)'; this.style.color='rgba(250,247,242,0.4)'">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Resume — Quant
        </a>
      </div>
    </header>

    <!-- Section divider -->
    <div class="flex items-center gap-4 mb-8">
      <span class="font-mono text-[11px] uppercase tracking-widest"
            style="color: rgba(250,247,242,0.4);">Work</span>
      <div class="flex-1 h-px" style="background: rgba(250,247,242,0.12);"></div>
      <span class="font-mono text-[11px]" style="color: rgba(250,247,242,0.4);">
        {projects.length} projects
      </span>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-24"
         id="project-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>

    <!-- Footer -->
    <footer class="py-8 flex flex-wrap items-center justify-between gap-4 text-xs font-mono"
            style="border-top: 1px solid rgba(250,247,242,0.08); color: rgba(250,247,242,0.25);">
      <span>© {new Date().getFullYear()} Deep Sarkar</span>
      <span>Top 22% Meta Hacker Cup &nbsp;·&nbsp; Expert - Codeforces (Rated: max-1856)</span>
    </footer>

  </main>

  <Modal client:load projects={projects} />
</Layout>

<script>
  document.getElementById('project-grid')?.addEventListener('click', (e) => {
    const target = e.target as Element
    if (target.closest('a') || target.closest('button')) return
    const card = target.closest('.project-card')
    if (!card) return
    window.dispatchEvent(new CustomEvent('open-project', {
      detail: Number(card.getAttribute('data-index'))
    }))
  })

  document.getElementById('project-grid')?.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent
    if (ke.key !== 'Enter' && ke.key !== ' ') return
    const card = (e.target as Element).closest('.project-card')
    if (!card) return
    window.dispatchEvent(new CustomEvent('open-project', {
      detail: Number((e.target as Element).getAttribute('data-index'))
    }))
  })
</script>
